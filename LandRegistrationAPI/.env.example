APP_NAME=Land Registration Management System
MONGO_DB_NAME=land_registration
MONGO_URI=mongodb://127.0.0.1:27017
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Replace this before enabling token-based authentication.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500
